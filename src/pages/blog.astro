---
import { getCollection } from 'astro:content';
import BlogPost from '../components/BlogPost.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "Welcome to my Astro Blog :D";
const allPosts = await getCollection("blog");
---

<BaseLayout pageTitle={pageTitle}>
	<h1>This is my Blogs Page</h1>
    <p>Here is where i will post blogs about my journey learning Astro.</p>
	<ul>
		{allPosts.map((post: any) => <BlogPost url={`/posts/${post.id}`} title={post.data.title} />)}
	</ul>
</BaseLayout>
